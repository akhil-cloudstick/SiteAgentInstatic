{
  "name": "siteagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiteAgent — fleet of native Instatic instances → Cloudflare. Control plane (Node) + Astro console.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "migrate": "node control-plane/registry/migrate.mjs",
    "admin:create": "node control-plane/registry/adminCreate.mjs",
    "test:deployer": "node control-plane/deployer/deploy.selftest.mjs",
    "test:allowlist": "node control-plane/lib/connectorAllowlist.selftest.mjs",
    "test:login": "node control-plane/registry/tenantUsers.selftest.mjs",
    "test:admin-auth": "node control-plane/lib/adminAuth.selftest.mjs",
    "test:new1": "node control-plane/lib/new1.selftest.mjs",
    "test:scope": "node control-plane/lib/scope.selftest.mjs",
    "test:brand": "node control-plane/lib/brand.selftest.mjs",
    "test:domains": "node control-plane/lib/domains.selftest.mjs",
    "test:verify": "node control-plane/deployer/verify.selftest.mjs",
    "test:stamp": "node control-plane/deployer/stamp.selftest.mjs",
    "test:ceiling": "node control-plane/lib/pagesCeiling.selftest.mjs",
    "test:spend": "node control-plane/lib/aiSpend.selftest.mjs",
    "test:studio": "node control-plane/runtime/studioStatus.selftest.mjs",
    "test:hub-session": "node control-plane/hub/hubSession.selftest.mjs",
    "test": "npm run test:deployer && npm run test:allowlist && npm run test:login && npm run test:admin-auth && npm run test:new1 && npm run test:scope && npm run test:brand && npm run test:domains && npm run test:verify && npm run test:stamp && npm run test:ceiling && npm run test:spend && npm run test:studio && npm run test:hub-session && npm run test:console-origin && npm run test:rollback",
    "start": "node control-plane/server.mjs",
    "console:dev": "npm --prefix ui run dev",
    "console:build": "npm --prefix ui run build",
    "test:console-origin": "node ui/src/lib/cp.selftest.mjs",
    "test:rollback": "node control-plane/deployer/rollback.selftest.mjs"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
