---
// Settings — platform-wide configuration (platform administrators only; the
// middleware and the API both enforce it). One card per concern, each its own
// form, with a section index on the left.
import ConsoleLayout from '../components/ConsoleLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { basePath, cpFetch } from '../lib/cp';

let error = '';
const baseUrl = basePath();

// Media providers the platform can hold a key for. These are the slots
// MMS-Design resolves from its environment, so a key saved here reaches every
// project's design daemon at spawn and projects never configure it themselves.
// Must stay in sync with MEDIA_PROVIDER_IDS (control-plane/registry/settings.mjs)
// and MEDIA_KEY_ENV (control-plane/runtime/odRuntime.mjs).
const MEDIA_PROVIDERS = [
  { id: 'openrouter', label: 'OpenRouter', note: 'Images via OpenRouter' },
  { id: 'replicate', label: 'Replicate', note: 'Image + video' },
  { id: 'fal', label: 'fal.ai', note: 'Image + video' },
  { id: 'bfl', label: 'Black Forest Labs', note: 'FLUX images' },
  { id: 'google', label: 'Google', note: 'Gemini / Imagen' },
  { id: 'minimax', label: 'MiniMax', note: 'Video + speech' },
  { id: 'kling', label: 'Kling', note: 'Video' },
  { id: 'elevenlabs', label: 'ElevenLabs', note: 'Speech' },
  { id: 'aihubmix', label: 'AIHubMix', note: 'Image + video + speech' },
  { id: 'tavily', label: 'Tavily', note: 'Web search' },
];

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) || '').trim() || undefined;
  // Independent forms; each posts only its own section. Unmentioned fields are
  // left undefined so the backend keeps their existing values.
  const section = String(f.get('section') || '');
  const fail = async (r: Response) => {
    let msg = 'Save failed';
    try { msg = (await r.json()).error || msg; } catch { /* keep the generic message */ }
    throw new Error(msg);
  };
  try {
    if (section === 'guidance') {
      // The global guidance is a file (rules/globalAiGuidanceRule.md) with its own endpoint.
      const r = await cpFetch(Astro.cookies, '/api/ai-guidance-default', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guidance: String(f.get('aiGuidance') || '') }),
      });
      if (!r.ok) await fail(r);
      return Astro.redirect(`${baseUrl}settings?saved=guidance#guidance`, 303);
    }
    let payload: Record<string, unknown> = {};
    if (section === 'cloudflare') {
      payload = { cloudflareToken: str('cloudflareToken'), cloudflareAccountId: str('cloudflareAccountId') };
    } else if (section === 'products') {
      // Unticked switches post nothing, so both flags are sent explicitly —
      // otherwise turning a product OFF would read as "not mentioned".
      payload = { designActive: !!f.get('designActive'), cmsActive: !!f.get('cmsActive') };
    } else if (section === 'media') {
      // A blank field keeps the stored key; clearing is the explicit Remove box.
      const mediaKeys: Record<string, string> = {};
      const mediaKeysClear: string[] = [];
      for (const { id } of MEDIA_PROVIDERS) {
        const v = String(f.get(`media_${id}`) || '').trim();
        if (v) mediaKeys[id] = v;
        if (f.get(`mediaClear_${id}`)) mediaKeysClear.push(id);
      }
      payload = { mediaKeys, mediaKeysClear };
    } else {
      // AI agent: OpenRouter key + per-task models + classifier + the MMS-Design model.
      let aiCategories = [];
      try { aiCategories = JSON.parse(String(f.get('aiCategories') || '[]')); } catch { /* validated by the API */ }
      payload = {
        openrouterKey: str('openrouterKey'),
        aiCategories,
        classifierModel: String(f.get('classifierModel') || '').trim(),
        designModel: String(f.get('designModel') || '').trim(),
      };
    }
    const r = await cpFetch(Astro.cookies, '/api/settings', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
    });
    if (!r.ok) await fail(r);
    const tag = ['cloudflare', 'media', 'products'].includes(section) ? section : 'ai';
    const anchor = tag === 'ai' ? 'ai' : tag;
    return Astro.redirect(`${baseUrl}settings?saved=${tag}#${anchor}`, 303);
  } catch (e) {
    error = (e as Error).message;
  }
}

let s: any = {};
try { s = await (await cpFetch(Astro.cookies, '/api/settings')).json(); }
catch (e) { error = `The control plane is not reachable: ${(e as Error).message}`; }

// Live OpenRouter catalogue, with tool-calling / vision flags for the pickers.
let models: any[] = [];
try { models = ((await (await cpFetch(Astro.cookies, '/api/models')).json()).models) || []; } catch { /* no key yet */ }

let guidance = '';
try { guidance = ((await (await cpFetch(Astro.cookies, '/api/ai-guidance-default')).json()).guidance) || ''; } catch { /* shown empty */ }
const GUIDANCE_MAX = 16000;

// Stored categories, or the Design/Content builtins on first use.
const seededCategories = (Array.isArray(s.aiCategories) && s.aiCategories.length)
  ? s.aiCategories
  : [
      { slug: 'design', name: 'Design', builtin: true, isDefault: true, modelId: s.openrouterModel || '',
        description: 'Layout, visual design, and structure: creating or arranging pages, sections, hero areas, buttons, images, colors, spacing, and fonts.' },
      { slug: 'content', name: 'Content', builtin: true, isDefault: false, modelId: s.openrouterModel || '',
        description: 'Writing or editing text: headlines, paragraphs, blog posts, product descriptions, and other wording on the page.' },
    ];

const saved = Astro.url.searchParams.get('saved');
const savedLabel = saved === 'cloudflare' ? 'Cloudflare settings saved.'
  : saved === 'ai' ? 'AI agent settings saved.'
  : saved === 'guidance' ? 'Global AI guidance saved — every project uses it on its next message.'
  : saved === 'media' ? 'Media provider keys saved — they apply when each project restarts.'
  : saved === 'products' ? 'Product availability saved — it applies to every project on its next request.'
  : saved ? 'Saved.' : '';

const designActive = s.designActive !== false;
const cmsActive = s.cmsActive !== false;
const mediaKeys = s.mediaKeys || {};
const noModels = models.length === 0;
const pickerPlaceholder = noModels ? 'Save an API key to load models' : 'Select a model…';

const SECTIONS = [
  ['ai', 'robot', 'AI agent'],
  ['media', 'photo-film', 'Media keys'],
  ['guidance', 'scroll', 'Global guidance'],
  ['products', 'cubes', 'Products'],
  ['cloudflare', 'cloud', 'Cloudflare'],
];
---
<ConsoleLayout title="Settings" active="settings">
  <PageHeader title="Settings" eyebrow="Platform">
    Platform-wide credentials and behaviour. Secrets are encrypted at rest and never shown — leave a secret field blank to keep its value.
  </PageHeader>

  {savedLabel && <div class="mms-alert mms-alert--ok" style="margin-bottom:16px"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>{savedLabel}</span></div>}
  {error && <div class="mms-alert mms-alert--err" role="alert" style="margin-bottom:16px"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>{error}</span></div>}

  <div class="mms-split mms-settings">
    <nav class="mms-sidenav" aria-label="Settings sections">
      {SECTIONS.map(([id, icon, label]) => (
        <a href={`#${id}`}><i class={`fa-solid fa-${icon}`} aria-hidden="true"></i>{label}</a>
      ))}
    </nav>

    <div class="mms-stack">
      <section class="mms-card" id="ai" aria-labelledby="ai-title">
        <div class="mms-card__head">
          <div class="mms-card__title">
            <span class="mms-card__icon"><i class="fa-solid fa-robot" aria-hidden="true"></i></span>
            <div>
              <h2 id="ai-title">AI agent</h2>
              <p>The OpenRouter key is used only by the AI gateway — no project ever holds it or sees which model runs.</p>
            </div>
          </div>
        </div>
        <form method="POST" id="settings-form">
          <input type="hidden" name="section" value="ai" />
          <div class="mms-card__body mms-form">
            <div class="mms-field">
              <label class="mms-label" for="or-key">OpenRouter API key {s.hasOpenrouterKey && <small>· set, blank keeps it</small>}</label>
              <input id="or-key" class="mms-input" name="openrouterKey" type="password" autocomplete="off" placeholder={s.hasOpenrouterKey ? '••••••••••••' : 'sk-or-…'} />
            </div>

            <div class="mms-field">
              <span class="mms-label">Models by task</span>
              <p class="mms-hint">Each project message is routed to one of these by what it asks. Exactly one is the Default, used when a request is unclear. Category models must support tool calling; the picker hides models that don't.</p>
              <div id="cat-rows" class="mms-stack" style="gap:10px"></div>
              <div><button type="button" class="mms-btn mms-btn--secondary mms-btn--sm" id="add-cat"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add category</button></div>
              <p class="mms-error-text" id="cat-error" role="alert" hidden></p>
              <input type="hidden" name="aiCategories" id="cat-value" />
            </div>

            <div class="mms-grid2">
              <div class="mms-field">
                <span class="mms-label">Classifier model</span>
                <div class="combo" id="classifier-combo">
                  <input type="hidden" name="classifierModel" class="combo-value" value={s.classifierModel || ''} />
                  <button type="button" class="mms-select__button combo-trigger" disabled={noModels}>
                    <span class:list={['mms-select__value', 'combo-trigger-label']} data-placeholder={pickerPlaceholder} data-empty={!s.classifierModel ? '' : undefined}>{s.classifierModel || pickerPlaceholder}</span>
                    <span class="combo-clear" role="button" aria-label="Clear selection" hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i></span>
                    <i class="fa-solid fa-chevron-down mms-select__chevron" aria-hidden="true"></i>
                  </button>
                  <div class="combo-panel" hidden>
                    <input type="text" class="combo-search" placeholder="Type to search…" autocomplete="off" />
                    <div class="combo-list"></div>
                  </div>
                </div>
                <p class="mms-hint">A cheap model that reads each prompt and picks the category. No tool calling needed.</p>
              </div>
              <div class="mms-field">
                <span class="mms-label">MMS-Design model</span>
                <div class="combo" id="design-combo">
                  <input type="hidden" name="designModel" class="combo-value" value={s.designModel || ''} />
                  <button type="button" class="mms-select__button combo-trigger" disabled={noModels}>
                    <span class:list={['mms-select__value', 'combo-trigger-label']} data-placeholder={pickerPlaceholder} data-empty={!s.designModel ? '' : undefined}>{s.designModel || pickerPlaceholder}</span>
                    <span class="combo-clear" role="button" aria-label="Clear selection" hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i></span>
                    <i class="fa-solid fa-chevron-down mms-select__chevron" aria-hidden="true"></i>
                  </button>
                  <div class="combo-panel" hidden>
                    <input type="text" class="combo-search" placeholder="Type to search…" autocomplete="off" />
                    <div class="combo-list"></div>
                  </div>
                </div>
                <p class="mms-hint">The one model every design session runs on. It must support tool calling and image input; only such models are listed. Blank reuses the Default category's model.</p>
              </div>
            </div>
          </div>
          <div class="mms-card__foot">
            <button type="submit" class="mms-btn mms-btn--primary">Save AI settings</button>
          </div>
        </form>
      </section>

      <section class="mms-card" id="media" aria-labelledby="media-title">
        <div class="mms-card__head">
          <div class="mms-card__title">
            <span class="mms-card__icon"><i class="fa-solid fa-photo-film" aria-hidden="true"></i></span>
            <div>
              <h2 id="media-title">Media provider keys</h2>
              <p>Image, video and speech generation in MMS-Design. A blank provider means that kind of generation is off. Keys apply when each project restarts.</p>
            </div>
          </div>
        </div>
        <form method="POST" data-busy="Saving media keys">
          <input type="hidden" name="section" value="media" />
          <div class="mms-table-card" style="border-radius:0">
            <table class="mms-table">
              <thead><tr><th>Provider</th><th>Key</th><th class="mms-right">Remove</th></tr></thead>
              <tbody>
                {MEDIA_PROVIDERS.map((p) => (
                  <tr>
                    <td><div class="mms-cell-main"><strong style="font-size:13px">{p.label}</strong><small>{p.note}</small></div></td>
                    <td style="width:55%">
                      <input class="mms-input" name={`media_${p.id}`} type="password" autocomplete="off"
                        aria-label={`${p.label} key`} placeholder={mediaKeys[p.id] ? mediaKeys[p.id] : 'Not set'} />
                    </td>
                    <td class="mms-right">
                      {mediaKeys[p.id] ? (
                        <label class="mms-check" style="justify-content:flex-end">
                          <input type="checkbox" name={`mediaClear_${p.id}`} value="1" aria-label={`Remove the ${p.label} key`} />
                        </label>
                      ) : <span class="mms-muted">—</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="mms-card__foot">
            <button type="submit" class="mms-btn mms-btn--primary">Save media keys</button>
          </div>
        </form>
      </section>

      <section class="mms-card" id="guidance" aria-labelledby="guidance-title">
        <div class="mms-card__head">
          <div class="mms-card__title">
            <span class="mms-card__icon"><i class="fa-solid fa-scroll" aria-hidden="true"></i></span>
            <div>
              <h2 id="guidance-title">Global AI guidance</h2>
              <p>Standing instructions added to every project's AI chat. Changes apply on each project's next message.</p>
            </div>
          </div>
        </div>
        <form method="POST" id="guidance-form">
          <input type="hidden" name="section" value="guidance" />
          <div class="mms-card__body">
            <textarea name="aiGuidance" class="mms-textarea mms-mono" style="min-height:360px;max-height:70vh" spellcheck="false" maxlength={GUIDANCE_MAX} aria-label="Global AI guidance">{guidance}</textarea>
          </div>
          <div class="mms-card__foot">
            <span class="mms-hint" id="guidance-count" style="margin-right:auto"></span>
            <button type="submit" class="mms-btn mms-btn--primary">Save guidance</button>
          </div>
        </form>
      </section>

      <section class="mms-card" id="products" aria-labelledby="products-title">
        <div class="mms-card__head">
          <div class="mms-card__title">
            <span class="mms-card__icon"><i class="fa-solid fa-cubes" aria-hidden="true"></i></span>
            <div>
              <h2 id="products-title">Products</h2>
              <p>Which products every project can open. With one off, people land straight in the other after signing in. Separate from a project's Lite/Advanced plan.</p>
            </div>
          </div>
        </div>
        <form method="POST">
          <input type="hidden" name="section" value="products" />
          <div class="mms-card__body mms-form">
            <label class="mms-switch">
              <input type="checkbox" name="designActive" value="1" checked={designActive} />
              <span><strong>MMS-Design</strong><br /><span class="mms-hint">Visual website design studio</span></span>
            </label>
            <label class="mms-switch">
              <input type="checkbox" name="cmsActive" value="1" checked={cmsActive} />
              <span><strong>MMS-CMS</strong><br /><span class="mms-hint">Content editing and publishing</span></span>
            </label>
            {!designActive && !cmsActive && (
              <div class="mms-alert mms-alert--err"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>Both products are off — people can sign in but have nowhere to go.</span></div>
            )}
          </div>
          <div class="mms-card__foot">
            <button type="submit" class="mms-btn mms-btn--primary">Save product availability</button>
          </div>
        </form>
      </section>

      <section class="mms-card" id="cloudflare" aria-labelledby="cf-title">
        <div class="mms-card__head">
          <div class="mms-card__title">
            <span class="mms-card__icon"><i class="fa-solid fa-cloud" aria-hidden="true"></i></span>
            <div>
              <h2 id="cf-title">Cloudflare</h2>
              <p>Used to publish project sites to Cloudflare Pages.</p>
            </div>
          </div>
        </div>
        <form method="POST">
          <input type="hidden" name="section" value="cloudflare" />
          <div class="mms-card__body mms-grid2">
            <div class="mms-field">
              <label class="mms-label" for="cf-token">API token {s.hasCloudflareToken && <small>· set, blank keeps it</small>}</label>
              <input id="cf-token" class="mms-input" name="cloudflareToken" type="password" autocomplete="off" placeholder={s.hasCloudflareToken ? '••••••••••••' : 'Cloudflare Pages token'} />
            </div>
            <div class="mms-field">
              <label class="mms-label" for="cf-account">Account id</label>
              <input id="cf-account" class="mms-input mms-mono" name="cloudflareAccountId" value={s.cloudflareAccountId || ''} placeholder="32-character account id" />
            </div>
          </div>
          <div class="mms-card__foot">
            <button type="submit" class="mms-btn mms-btn--primary">Save Cloudflare settings</button>
          </div>
        </form>
      </section>
    </div>
  </div>
</ConsoleLayout>

<!--
  Global on purpose: the category cards and their model pickers are built by the
  script below, so they never receive Astro's scoped-style attribute. Every rule
  is namespaced under .mms-settings and uses the shell tokens (dark mode works).
-->
<style is:global>
  .mms-settings .combo { position: relative; }
  .mms-settings .combo-trigger-label[data-empty] { color: var(--mms-text-muted); }
  .mms-settings .combo-clear { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; color: var(--mms-text-muted); cursor: pointer; }
  .mms-settings .combo-clear:hover { background: var(--c-danger-bg); color: var(--mms-danger); }
  .mms-settings .combo-clear[hidden] { display: none; }
  .mms-settings .combo-panel { position: absolute; z-index: 40; left: 0; right: 0; margin-top: 6px; overflow: hidden; border: 1px solid var(--mms-border); border-radius: 10px; background: var(--mms-surface-raised); box-shadow: var(--mms-shadow-menu); }
  .mms-settings .combo-panel[hidden] { display: none; }
  .mms-settings .combo-search { width: 100%; height: 42px; padding: 0 14px; border: 0; border-bottom: 1px solid var(--mms-border); background: transparent; color: var(--mms-text); font: inherit; outline: none; }
  .mms-settings .combo-list { max-height: 300px; overflow-y: auto; padding: 6px; }
  .mms-settings .combo-item { padding: 8px 12px; border-radius: 7px; cursor: pointer; }
  .mms-settings .combo-item:hover, .mms-settings .combo-item.active { background: var(--mms-surface-tint); }
  .mms-settings .combo-item.selected .combo-item-id { color: var(--mms-action-strong); }
  .mms-settings .combo-item-id { font-weight: 680; font-size: 13px; color: var(--mms-text); }
  .mms-settings .combo-item-name { margin-top: 1px; font-size: 12px; color: var(--mms-text-muted); }
  .mms-settings .combo-item-warn { margin-top: 1px; font-size: 11px; color: var(--mms-warning); }
  .mms-settings .combo-empty { padding: 16px; color: var(--mms-text-muted); text-align: center; }

  .mms-settings .cat-card { padding: 14px 16px; border: 1px solid var(--mms-border); border-radius: 10px; background: var(--mms-surface-raised); }
  .mms-settings .cat-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .mms-settings .cat-card-body { display: grid; gap: 12px; }
  .mms-settings .cat-name[readonly] { background: var(--mms-surface-tint); cursor: default; }
  .mms-settings .cat-desc { min-height: 64px; font-size: 12px; }
  #guidance-count[data-near] { color: var(--mms-danger); }
  .mms-settings .mms-card > form .mms-card__foot { border-radius: 0 0 var(--c-radius-card) var(--c-radius-card); }
</style>

<script define:vars={{ models, seededCategories }}>
  (function () {
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Every open picker, so one opening closes the others and scroll/Escape
    // close whichever is open.
    const closers = new Set();
    const closeAll = (except) => closers.forEach((c) => { if (c !== except) c(); });
    window.addEventListener('scroll', (e) => {
      if (e.target instanceof Element && e.target.closest('.combo-panel')) return;
      closeAll();
    }, true);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

    // Searchable model picker scoped to a root .combo element.
    function makeCombo(root, opts) {
      const list = opts.list;
      const trigger = root.querySelector('.combo-trigger');
      const label = root.querySelector('.combo-trigger-label');
      const panel = root.querySelector('.combo-panel');
      const search = root.querySelector('.combo-search');
      const listBox = root.querySelector('.combo-list');
      const valueInput = root.querySelector('.combo-value');
      const clearBtn = root.querySelector('.combo-clear');
      if (!trigger || !list.length) return { get: () => (valueInput ? valueInput.value : '') };
      trigger.disabled = false;
      let filtered = list;
      let active = -1;

      function syncClear() { if (clearBtn) clearBtn.hidden = !valueInput.value; }
      syncClear();

      function render() {
        listBox.innerHTML = filtered.length
          ? filtered.map((m, i) =>
              `<div class="combo-item${i === active ? ' active' : ''}${m.id === valueInput.value ? ' selected' : ''}" data-id="${esc(m.id)}" role="option">` +
              `<div class="combo-item-id">${esc(m.id)}</div><div class="combo-item-name">${esc(m.name)}</div>` +
              (m.toolCalling === null ? `<div class="combo-item-warn">Tool support unknown</div>` : ``) +
              `</div>`).join('')
          : '<div class="combo-empty">No models match</div>';
      }
      function close() { panel.hidden = true; trigger.setAttribute('aria-expanded', 'false'); }
      function open() {
        closeAll(close);
        panel.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        search.value = '';
        filtered = list;
        active = -1;
        render();
        search.focus();
      }
      closers.add(close);
      function select(id) {
        valueInput.value = id;
        label.textContent = id;
        label.removeAttribute('data-empty');
        syncClear();
        close();
        trigger.focus();
      }
      function clearSelection() {
        valueInput.value = '';
        label.textContent = label.dataset.placeholder || 'Select a model…';
        label.setAttribute('data-empty', '');
        syncClear();
        close();
      }
      trigger.addEventListener('click', () => (panel.hidden ? open() : close()));
      if (clearBtn) clearBtn.addEventListener('click', (e) => { e.stopPropagation(); clearSelection(); });
      search.addEventListener('input', () => {
        const q = search.value.toLowerCase().trim();
        filtered = q ? list.filter((m) => m.id.toLowerCase().includes(q) || (m.name || '').toLowerCase().includes(q)) : list;
        active = -1;
        render();
      });
      listBox.addEventListener('click', (e) => {
        const item = e.target.closest('.combo-item');
        if (item) select(item.dataset.id);
      });
      search.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, filtered.length - 1); render(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); render(); }
        else if (e.key === 'Enter') { e.preventDefault(); if (active >= 0 && filtered[active]) select(filtered[active].id); }
        else if (e.key === 'Escape') { close(); trigger.focus(); }
      });
      document.addEventListener('pointerdown', (e) => { if (!root.contains(e.target)) close(); });
      return { get: () => valueInput.value };
    }

    // Category models must support tools: hide known-false, keep unknown (warned).
    const toolModels = models.filter((m) => m.toolCalling !== false);
    // The design model also needs image input (people attach reference screenshots).
    const designModels = models.filter((m) => m.toolCalling !== false && m.vision !== false);

    const rowsBox = document.getElementById('cat-rows');
    const rows = [];

    function slugify(name, taken) {
      let base = String(name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'category';
      if (base.length > 60) base = base.slice(0, 60).replace(/-+$/g, '');
      let slug = base;
      let n = 2;
      while (taken.has(slug)) slug = `${base}-${n++}`;
      return slug;
    }

    function addRow(cat) {
      const row = document.createElement('div');
      row.className = 'cat-card';
      const picker = models.length ? 'Select a model…' : 'Save an API key to load models';
      row.innerHTML =
        `<div class="cat-card-top">` +
          `<label class="mms-check"><input type="radio" name="__cat_default" ${cat.isDefault ? 'checked' : ''} /> <span>Default category</span></label>` +
          (cat.builtin ? `<span class="mms-chip mms-chip--sm">Built-in</span>` : `<button type="button" class="mms-iconbtn cat-remove" aria-label="Remove category"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>`) +
        `</div>` +
        `<div class="cat-card-body">` +
          `<div class="mms-grid2">` +
            `<div class="mms-field"><span class="mms-label">Category name</span>` +
              `<input class="mms-input cat-name" value="${esc(cat.name || '')}" ${cat.builtin ? 'readonly' : 'placeholder="e.g. Products"'} /></div>` +
            `<div class="mms-field"><span class="mms-label">Model</span>` +
              `<div class="combo cat-model-combo">` +
                `<input type="hidden" class="combo-value" value="${esc(cat.modelId || '')}" />` +
                `<button type="button" class="mms-select__button combo-trigger" ${models.length ? '' : 'disabled'}>` +
                  `<span class="mms-select__value combo-trigger-label" data-placeholder="${picker}" ${cat.modelId ? '' : 'data-empty'}>${esc(cat.modelId || picker)}</span>` +
                  `<span class="combo-clear" role="button" aria-label="Clear selection" hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i></span>` +
                  `<i class="fa-solid fa-chevron-down mms-select__chevron" aria-hidden="true"></i>` +
                `</button>` +
                `<div class="combo-panel" hidden><input type="text" class="combo-search" placeholder="Type to search…" autocomplete="off" /><div class="combo-list"></div></div>` +
              `</div></div>` +
          `</div>` +
          `<div class="mms-field"><span class="mms-label">When to use <small>(helps routing)</small></span>` +
            `<textarea class="mms-textarea cat-desc" placeholder="e.g. Writing or editing text on the page">${esc(cat.description || '')}</textarea></div>` +
        `</div>`;
      rowsBox.appendChild(row);

      const combo = makeCombo(row.querySelector('.cat-model-combo'), { list: toolModels });
      const nameEl = row.querySelector('.cat-name');
      const descEl = row.querySelector('.cat-desc');
      const radioEl = row.querySelector('input[type=radio]');
      const entry = {
        builtin: !!cat.builtin,
        fixedSlug: cat.builtin ? cat.slug : null,
        nameEl,
        getName: () => nameEl.value.trim(),
        getDesc: () => descEl.value,
        getModel: () => combo.get(),
        isDefault: () => radioEl.checked,
      };
      rows.push(entry);
      const rm = row.querySelector('.cat-remove');
      if (rm) rm.addEventListener('click', () => {
        const i = rows.indexOf(entry);
        if (i >= 0) rows.splice(i, 1);
        row.remove();
      });
    }

    seededCategories.forEach(addRow);
    document.getElementById('add-cat').addEventListener('click', () =>
      addRow({ name: '', description: '', modelId: '', isDefault: false, builtin: false }));
    makeCombo(document.getElementById('classifier-combo'), { list: models });
    makeCombo(document.getElementById('design-combo'), { list: designModels });

    // Serialise categories into the hidden field; problems show inline.
    const errorEl = document.getElementById('cat-error');
    const showError = (msg, focusEl) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
      if (focusEl) focusEl.focus();
    };
    document.getElementById('settings-form').addEventListener('submit', (e) => {
      errorEl.hidden = true;
      const taken = new Set();
      const out = [];
      let defaults = 0;
      for (const r of rows) {
        const name = r.getName();
        if (!name) { e.preventDefault(); showError('Every category needs a name.', r.nameEl); return; }
        const model = r.getModel();
        if (!model) { e.preventDefault(); showError(`Category “${name}” needs a model.`); return; }
        const slug = r.fixedSlug || slugify(name, taken);
        taken.add(slug);
        const isDefault = r.isDefault();
        if (isDefault) defaults++;
        out.push({ slug, name, description: r.getDesc(), modelId: model, isDefault, builtin: r.builtin });
      }
      if (defaults !== 1) { e.preventDefault(); showError('Pick exactly one Default category.'); return; }
      document.getElementById('cat-value').value = JSON.stringify(out);
    });

    // Guidance: live character counter, warning near the limit.
    const area = document.querySelector('#guidance-form textarea');
    const count = document.getElementById('guidance-count');
    if (area && count) {
      const max = Number(area.getAttribute('maxlength')) || 16000;
      const sync = () => {
        const n = area.value.length;
        count.textContent = `${n.toLocaleString()} / ${max.toLocaleString()} characters`;
        count.toggleAttribute('data-near', n > max * 0.9);
      };
      area.addEventListener('input', sync);
      sync();
    }
  })();
</script>
