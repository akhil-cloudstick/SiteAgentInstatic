---
// The console's landing page follows the setup order: administrators above a
// single Business start at Organisation, a Business administrator at Projects.
// (middleware.ts redirects first; this is the same rule for any path it misses.)
import { basePath } from '../lib/cp';

const level = Astro.locals.admin?.scope?.level;
return Astro.redirect(`${basePath()}${level === 'business' ? 'projects' : 'org'}`, 302);
---
