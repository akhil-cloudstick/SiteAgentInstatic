---
// MCP Agents — scoped machine access for external AI agents, one key per
// project. Keys are minted in a dialog and shown exactly once.
import ConsoleLayout from '../components/ConsoleLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Modal from '../components/Modal.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import RowMenu from '../components/RowMenu.astro';
import Select from '../components/Select.astro';
import StatusChip from '../components/StatusChip.astro';
import EmptyState from '../components/EmptyState.astro';
import { basePath, cpFetch } from '../lib/cp';
import { cpGet, okJson } from '../lib/org';

const base = basePath();
let error = '';
let notice = '';
// A freshly minted key is rendered in this response instead of redirecting:
// the plaintext exists exactly once and must never travel in a URL (history,
// logs, referrers). Reload the page and it is gone.
let minted: any = null;

const PERMISSION_GROUPS: Array<{ title: string; items: Array<[string, string]> }> = [
  {
    title: 'Content',
    items: [
      ['read', 'Read pages, posts and collections'],
      ['create', 'Create new entries'],
      ['edit', 'Edit entries and page layouts'],
      ['delete', 'Delete entries (recoverable from Trash)'],
      ['publish', 'Publish entries to the live site'],
      ['tables.manage', 'Create new collections'],
    ],
  },
  {
    title: 'Media',
    items: [
      ['media.read', 'Browse the media library'],
      ['media.write', 'Upload and edit media'],
      ['media.delete', 'Delete media (recoverable from Trash)'],
    ],
  },
  {
    title: 'Design',
    items: [['design.edit', 'Edit global design tokens and styles']],
  },
];
const PRESET_LABELS: Record<string, string> = {
  'read-only': 'Read only',
  author: 'Author',
  publisher: 'Publisher',
  full: 'Everything',
};

const json = (body: unknown) => ({
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify(body),
});

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const intent = String(f.get('intent') || '');
  try {
    if (intent === 'create') {
      const tablesRaw = String(f.get('tables') || '').trim();
      const expiresRaw = String(f.get('expiresInDays') || '').trim();
      const out = await okJson(await cpFetch(Astro.cookies, '/api/mcp/agents', json({
        tenantSlug: String(f.get('tenantSlug') || ''),
        label: String(f.get('label') || '').trim() || 'agent',
        permissions: f.getAll('permissions').map(String),
        tables: tablesRaw ? tablesRaw.split(',').map((t) => t.trim()).filter(Boolean) : ['*'],
        expiresInDays: expiresRaw ? Number(expiresRaw) : undefined,
      })), 'Could not create the key');
      minted = { ...out.agent, endpoint: out.endpoint };
    } else if (intent === 'revoke') {
      await okJson(await cpFetch(Astro.cookies, `/api/mcp/agents/${encodeURIComponent(String(f.get('keyId') || ''))}/revoke`, { method: 'POST' }), 'Could not revoke the key');
      return Astro.redirect(`${base}mcp?revoked=1`, 303);
    } else if (intent === 'install-bridge') {
      const slug = String(f.get('tenantSlug') || '');
      const out = await okJson(await cpFetch(Astro.cookies, `/api/mcp/tenants/${encodeURIComponent(slug)}/install-bridge`, { method: 'POST' }), 'Could not install the bridge');
      return Astro.redirect(`${base}mcp?installed=${encodeURIComponent(slug)}&v=${encodeURIComponent(out.version || '')}`, 303);
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

if (Astro.url.searchParams.get('revoked')) notice = 'Key revoked. It stops working immediately.';
const installedSlug = Astro.url.searchParams.get('installed');
if (installedSlug) {
  const v = Astro.url.searchParams.get('v');
  notice = `Bridge installed on ${installedSlug}${v ? ` (v${v})` : ''}. Content tools are live for that project.`;
}

let directory: any[] = [];
let agents: any[] = [];
let presets: Record<string, string[]> = {};
try {
  const [d, a, p] = await Promise.all([
    // No `await` inside the list: awaiting here would have started each call
    // only after the one before it came back, which is what Promise.all avoids.
    cpGet(Astro.cookies, '/api/mcp/directory', 'Could not list projects'),
    cpGet(Astro.cookies, '/api/mcp/agents', 'Could not list keys'),
    cpGet(Astro.cookies, '/api/mcp/presets', 'Could not load presets'),
  ]);
  directory = d.tenants || [];
  agents = a.agents || [];
  presets = p.presets || {};
} catch (e) {
  error = error || (e as Error).message;
}

const activeProjects = directory.filter((t) => t.status !== 'removed');
const projectOptions = activeProjects.map((t) => ({
  value: t.slug,
  label: t.slug,
  hint: t.bridgeInstalled ? 'Bridge installed' : t.bridgeInstalled === null ? 'Project not running' : 'Bridge not installed — content tools won’t work yet',
}));
const fmt = (v: string | null) => (v ? new Date(v).toLocaleString() : 'Never');
const keyState = (a: any) => (a.revokedAt ? 'revoked' : a.expiresAt && new Date(a.expiresAt) < new Date() ? 'expired' : 'active');
---
<ConsoleLayout title="MCP Agents" active="mcp">
  <PageHeader title="MCP Agents" eyebrow="Machine access">
    Give an external AI agent scoped access to one project's CMS. Each key belongs to one project and carries its own permissions.
    <Fragment slot="actions">
      <a class="mms-btn mms-btn--secondary" href={`${base}mcp/documentation`}>
        <i class="fa-solid fa-book" aria-hidden="true"></i> How to connect
      </a>
      <button type="button" class="mms-btn mms-btn--primary" data-open-modal="new-key" disabled={activeProjects.length === 0}>
        <i class="fa-solid fa-key" aria-hidden="true"></i> New agent key
      </button>
    </Fragment>
  </PageHeader>

  {error && <div class="mms-alert mms-alert--err" role="alert" style="margin-bottom:16px"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>{error}</span></div>}
  {notice && !error && <div class="mms-alert mms-alert--ok" style="margin-bottom:16px"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>{notice}</span></div>}

  <div class="mms-stack">
    <section aria-labelledby="keys-title">
      <h2 id="keys-title" class="mms-section-title">Agent keys</h2>
      <div class="mms-toolbar" data-filter-for="keys-table">
        <label class="mms-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <span class="mms-sr-only">Search keys</span>
          <input type="search" placeholder="Search by label" data-filter="search" />
        </label>
        {activeProjects.length > 1 && (
          <Select name="projectFilter" ariaLabel="Filter by project" placeholder="All projects"
            options={[{ value: '', label: 'All projects' }, ...activeProjects.map((t) => ({ value: t.slug, label: t.slug }))]}
            attrs={{ 'data-filter': 'project' }} />
        )}
        <Select name="stateFilter" ariaLabel="Filter by status" placeholder="All statuses"
          options={[{ value: '', label: 'All statuses' }, { value: 'active', label: 'Active' }, { value: 'expired', label: 'Expired' }, { value: 'revoked', label: 'Revoked' }]}
          attrs={{ 'data-filter': 'state' }} />
        <span class="mms-toolbar__count" data-filter-count></span>
      </div>
      <div class="mms-table-card">
        {agents.length === 0 ? (
          <EmptyState icon="key" title="No keys yet">Create a key to connect an AI agent to a project.</EmptyState>
        ) : (
          <table class="mms-table" id="keys-table">
            <thead>
              <tr><th>Key</th><th>Project</th><th>Permissions</th><th>Tables</th><th>Last used</th><th>Status</th><th class="mms-right">Actions</th></tr>
            </thead>
            <tbody>
              {agents.map((a) => {
                const state = keyState(a);
                return (
                  <tr data-row data-search={`${a.label} ${a.keyId}`} data-project={a.tenantSlug} data-state={state}>
                    <td><div class="mms-cell-main"><strong>{a.label}</strong><small class="mms-mono">{a.keyId}</small></div></td>
                    <td class="mms-mono">{a.tenantSlug}</td>
                    <td>
                      <div class="mms-row" style="gap:4px">
                        {(a.permissions || []).length === 0 ? <span class="mms-muted">None</span> : (a.permissions || []).map((p: string) => <StatusChip small>{p}</StatusChip>)}
                      </div>
                    </td>
                    <td class="mms-muted">{(a.tables || ['*']).join(', ') === '*' ? 'All' : (a.tables || []).join(', ')}</td>
                    <td class="mms-muted">{fmt(a.lastUsedAt)}</td>
                    <td>
                      {state === 'active' && <StatusChip tone="success" dot>Active</StatusChip>}
                      {state === 'expired' && <StatusChip tone="warning" dot>Expired</StatusChip>}
                      {state === 'revoked' && <StatusChip tone="danger" dot>Revoked</StatusChip>}
                    </td>
                    <td>
                      <div class="mms-cell-actions">
                        {state === 'revoked' ? <span class="mms-hint">—</span> : (
                          <RowMenu label={`Actions for ${a.label}`}>
                            <button type="button" class="mms-menu__item mms-menu__item--danger" role="menuitem" data-open-modal="revoke-key"
                              data-prefill-keyId={a.keyId}
                              data-fill-message={`Revoke “${a.label}” for ${a.tenantSlug}? The agent loses access immediately.`}>
                              <i class="fa-solid fa-ban" aria-hidden="true"></i> Revoke key
                            </button>
                          </RowMenu>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
              <tr class="mms-no-results" hidden><td colspan="7">No keys match these filters.</td></tr>
            </tbody>
          </table>
        )}
      </div>
    </section>

    <section class="mms-card" aria-labelledby="endpoints-title">
      <div class="mms-card__head">
        <div class="mms-card__title">
          <span class="mms-card__icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span>
          <div>
            <h2 id="endpoints-title">Connection endpoints</h2>
            <p>One endpoint per project. Content tools need the bridge installed there; media and design tools work without it.</p>
          </div>
        </div>
      </div>
      {directory.length === 0 ? (
        <p class="mms-muted" style="margin:0;padding:18px">No projects yet.</p>
      ) : (
        <div class="mms-table-card">
          <table class="mms-table">
            <thead>
              <tr><th>Project</th><th>Endpoint</th><th>Bridge</th><th>Active keys</th><th>Last used</th><th class="mms-right">Actions</th></tr>
            </thead>
            <tbody>
              {directory.map((t) => (
                <tr>
                  <td class="mms-mono">{t.slug}</td>
                  <td>
                    <span class="mms-row" style="flex-wrap:nowrap;gap:6px">
                      <span class="mms-mono" style="overflow-wrap:anywhere">{t.endpoint}</span>
                      <button type="button" class="mms-iconbtn" data-copy={t.endpoint} aria-label={`Copy endpoint for ${t.slug}`}>
                        <i class="fa-solid fa-copy" aria-hidden="true"></i>
                      </button>
                    </span>
                  </td>
                  <td>
                    {t.bridgeInstalled === null
                      ? <StatusChip>Project not running</StatusChip>
                      : t.bridgeInstalled
                        ? <StatusChip tone="success" dot>Installed</StatusChip>
                        : <StatusChip tone="warning" dot>Not installed</StatusChip>}
                  </td>
                  <td>{t.activeKeys}</td>
                  <td class="mms-muted">{fmt(t.lastUsed)}</td>
                  <td>
                    <div class="mms-cell-actions">
                      {t.bridgeInstalled !== null && (
                        <button type="button" class="mms-btn mms-btn--secondary mms-btn--sm" data-open-modal="install-bridge"
                          data-prefill-tenantSlug={t.slug}
                          data-fill-message={`${t.bridgeInstalled ? 'Reinstall' : 'Install'} the bridge on ${t.slug}? It is built from source and installed into that project.`}>
                          <i class="fa-solid fa-plug-circle-plus" aria-hidden="true"></i> {t.bridgeInstalled ? 'Reinstall' : 'Install bridge'}
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>

  {activeProjects.length > 0 && (
    <Modal id="new-key" title="New agent key" eyebrow="MCP Agents" size="xl" intent="create" busy="Creating key">
      <div class="mms-form">
        <div class="mms-grid2">
          <div class="mms-field">
            <label class="mms-label" for="nk-project">Project</label>
            <Select id="nk-project" name="tenantSlug" required placeholder="Choose a project" options={projectOptions}
              value={activeProjects.length === 1 ? activeProjects[0].slug : null} />
          </div>
          <div class="mms-field">
            <label class="mms-label" for="nk-label">Label</label>
            <input id="nk-label" class="mms-input" name="label" placeholder="marketing-agent" autocomplete="off" />
          </div>
        </div>
        <div class="mms-grid2">
          <div class="mms-field">
            <label class="mms-label" for="nk-tables">Tables <small>(comma-separated)</small></label>
            <input id="nk-tables" class="mms-input" name="tables" placeholder="All tables" />
          </div>
          <div class="mms-field">
            <label class="mms-label" for="nk-expiry">Expires in <small>(days)</small></label>
            <input id="nk-expiry" class="mms-input" name="expiresInDays" type="number" min="1" placeholder="Never" />
          </div>
        </div>
        <div class="mms-field">
          <span class="mms-label">Permissions</span>
          <div class="mms-row" style="gap:6px">
            <span class="mms-hint">Quick pick:</span>
            {Object.entries(presets).map(([key, perms]) => (
              <button type="button" class="mms-btn mms-btn--secondary mms-btn--sm" data-check-set={(perms as string[]).join(',')} data-check-name="permissions">
                {PRESET_LABELS[key] ?? key}
              </button>
            ))}
          </div>
          <div class="mms-perm-grid">
            {PERMISSION_GROUPS.map((group) => (
              <fieldset class="mms-perm-group">
                <legend>{group.title}</legend>
                {group.items.map(([value, description]) => (
                  <label class="mms-check">
                    <input type="checkbox" name="permissions" value={value} checked={value === 'read'} />
                    <span><span class="mms-mono">{value}</span><small>{description}</small></span>
                  </label>
                ))}
              </fieldset>
            ))}
          </div>
          <p class="mms-hint">Grant the least the agent needs. Without <span class="mms-mono">publish</span>, every edit stays a draft a person can review.</p>
        </div>
      </div>
      <Fragment slot="footer">
        <button type="button" class="mms-btn mms-btn--secondary" data-close-modal>Cancel</button>
        <button type="submit" class="mms-btn mms-btn--primary">Create key</button>
      </Fragment>
    </Modal>
  )}

  {minted && (
    <Modal id="minted-key" title="Your new agent key" eyebrow="Shown once" size="xl" openOnLoad>
      <div class="mms-form">
        <div class="mms-alert mms-alert--warn">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          <span>This is the only time the key is shown. Store it in the agent's configuration now.</span>
        </div>
        {[
          ['Key', 'mk-key', minted.token],
          ['Endpoint', 'mk-endpoint', minted.endpoint],
          ['Connect with Claude Code', 'mk-claude', `claude mcp add mms-cms --transport http ${minted.endpoint} --header "Authorization: Bearer ${minted.token}"`],
          ['Any other MCP client', 'mk-manual', `endpoint: ${minted.endpoint}\nheader:   Authorization: Bearer ${minted.token}`],
        ].map(([label, id, value]) => (
          <div class="mms-field">
            <span class="mms-label">{label}</span>
            <div class="mms-copyrow">
              <pre class="mms-code" id={id}>{value}</pre>
              <button type="button" class="mms-btn mms-btn--secondary" data-copy-target={id}>
                <i class="fa-solid fa-copy" aria-hidden="true"></i> <span class="mms-copy-label">Copy</span>
              </button>
            </div>
          </div>
        ))}
      </div>
      <Fragment slot="footer">
        <a class="mms-btn mms-btn--secondary" href={`${base}mcp/documentation`}>How to connect</a>
        <button type="button" class="mms-btn mms-btn--primary" data-close-modal>I've stored it</button>
      </Fragment>
    </Modal>
  )}

  <ConfirmModal id="revoke-key" title="Revoke key" intent="revoke" confirmLabel="Revoke key" fields={['keyId']} busy="Revoking">
    <Fragment slot="message">Revoke this key? The agent loses access immediately.</Fragment>
  </ConfirmModal>

  <ConfirmModal id="install-bridge" title="Install bridge" intent="install-bridge" confirmLabel="Install" fields={['tenantSlug']} tone="primary" busy="Installing the bridge — this can take a minute">
    <Fragment slot="message">Install the bridge on this project?</Fragment>
  </ConfirmModal>
</ConsoleLayout>
