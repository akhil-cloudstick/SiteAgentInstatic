---
// The ⋮ row menu. Items are `.mms-menu__item` links, dialog openers
// (`data-open-modal` + `data-prefill-*`) or small POST forms. It closes on an
// outside click, on scroll and on Escape (scripts/console.ts).
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="mms-rowmenu" data-rowmenu>
  <button type="button" class="mms-kebab" aria-haspopup="menu" aria-expanded="false" aria-label={label}>
    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
  </button>
  <div class="mms-menu" role="menu" aria-label={label} hidden>
    <slot />
  </div>
</div>
